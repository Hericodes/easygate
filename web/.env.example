# Copy this file to .env and fill it in. Never commit .env.

# PostgreSQL (e.g. Neon, https://neon.tech). In Neon's "Connect" dialog:
#   DATABASE_URL           = connection string with "Connection pooling" ON  (host contains -pooler)
#   DATABASE_URL_UNPOOLED  = connection string with "Connection pooling" OFF (used for migrations)
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Long random string used to sign login tokens. Use a different one in production.
AUTH_SECRET="replace-with-a-long-random-string"

# Public URL of the site, used for the Paystack and Google redirects.
# Optional on Vercel: if unset, the site's own address is used.
APP_URL="http://localhost:3000"

# Paystack secret key (https://dashboard.paystack.com/#/settings/developers).
# Empty in development = built-in test checkout. Required in production for paid tickets.
PAYSTACK_SECRET_KEY=""

# Google sign-in (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI: {your site}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
